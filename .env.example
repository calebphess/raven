# ── Identity ──────────────────────────────────────────────────────────────────
# Your name and pronouns — used in the CLAUDE.md prompt so Claude addresses
# you correctly in voice responses.
RAVEN_USER_NAME=your_name
RAVEN_USER_PRONOUNS=they/them

# ── ElevenLabs ────────────────────────────────────────────────────────────────
# API key — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_key_here

# Voice ID — copy from the ElevenLabs Voice Library URL or API
# Default: Rachel (ElevenLabs built-in)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# TTS model: eleven_turbo_v2 (fast, low latency) | eleven_multilingual_v2 (quality)
ELEVENLABS_MODEL=eleven_turbo_v2

# Playback speed multiplier: 1.0 = normal, 1.3 = 130%, range ~0.7–1.5
ELEVENLABS_SPEED=1.3

# Named voices for hot-swapping — say "switch to <name>" to activate one.
# Format: Name:voiceId:speed:personality — separate voices with |
# Per-voice speed overrides ELEVENLABS_SPEED. The personality is injected into
# Claude's context every turn so <raven> text matches the style.
# ELEVENLABS_VOICES=Raven:voiceId1:1.2:Warm and conversational|Carter:voiceId2:0.9:Confident and direct

# ── Whisper (speech-to-text) ──────────────────────────────────────────────────
# Model size: tiny (fastest) | base | small | medium (most accurate)
# First run downloads the model (~150MB for base).
WHISPER_MODEL=base
